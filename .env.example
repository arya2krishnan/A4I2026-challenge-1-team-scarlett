# Copy to .env and edit. Real environment variables override this file. .env is git-ignored.

# ---- Project / region --------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
# Region of Agent Runtime and Cloud Run (NOT the model endpoint).
GOOGLE_CLOUD_LOCATION=us-central1

# ---- BigQuery -----------------------------------------------------------------
BQ_DATASET=a4i_climate
BQ_LOCATION=US

# ---- Models (verify with: make check-models) -----------------------------------
MODEL=gemini-3.6-flash
MODEL_LOCATION=global

# ---- MCP Toolbox (the managed MCP layer in front of BigQuery) ---------------------
# Local: `make toolbox-local` serves it here. Deployed: `make deploy-toolbox` writes the Cloud Run URL here.
TOOLBOX_URL=http://127.0.0.1:5000
TOOLBOX_TOOLSET=heat_dispatch
TOOLBOX_SERVICE_NAME=heat-toolbox
# Service account Toolbox runs as (needs bigquery.jobUser + dataViewer + secretAccessor). Created by `make gcp-setup`.
TOOLBOX_SERVICE_ACCOUNT=

# ---- Optional ---------------------------------------------------------------------
# Enables street addresses on dispatch stops and geocoding of intersections (Geocoding API).
MAPS_API_KEY=

# ---- Deploy wiring (written by the deploy scripts) ------------------------------------
# Existing service account the AGENT runs as on Agent Runtime. Strongly recommended: it is the identity that is
# granted run.invoker on the Toolbox service. Empty = the default Agent Runtime service agent.
AGENT_SERVICE_ACCOUNT=
AGENT_RESOURCE_NAME=
CLIENT_SERVICE_NAME=heat-dispatch-client
CLIENT_SERVICE_ACCOUNT=


# Dispatch approval API (api/, `make api-local`). The key signs approved dispatches: use a long random value
# (python -c 'import secrets; print(secrets.token_hex(32))'), kept in Secret Manager when deployed.
DISPATCH_SIGNING_KEY=
DISPATCH_DB=
# Cloud Run (make deploy-api): Firestore-backed; the key comes from Secret Manager, the URL is written here.
DISPATCH_STORE=sqlite
FIRESTORE_DATABASE=heat-dispatch
DISPATCH_API_SERVICE_NAME=heat-dispatch-api
DISPATCH_API_URL=

# ---- Heat Dispatch Console (web/) -------------------------------------------------------
WEB_SERVICE_NAME=heat-dispatch-web
# Written by `make deploy-web` (it creates heat-web@ with least privilege).
WEB_SERVICE_ACCOUNT=
WEB_URL=
# IAP on Cloud Run (true) or plain Cloud Run IAM (false). WEB_USERS: comma-separated IAP members to grant.
WEB_IAP=true
# true = anyone with the link can open the console, no login (for judging; switch back afterwards). Overrides WEB_IAP.
WEB_PUBLIC=false
WEB_USERS=

